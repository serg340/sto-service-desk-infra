events {}

http {
    server {
        listen 80;
        server_name api.stodesk.biz.ua;

        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name api.stodesk.biz.ua;

        ssl_certificate /etc/letsencrypt/live/stodesk.biz.ua/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/stodesk.biz.ua/privkey.pem;

        location / {
            proxy_pass http://host.docker.internal:5000;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}
